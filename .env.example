# ==============================================================================
# IIIT Tiruchirappalli Academic Attendance Portal - Environment Configuration
# ==============================================================================

# Application URL (used for building authenticated email action links)
# Production: https://portal.iiitt.ac.in (or your deployment URL)
# Development: http://localhost:3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_FIREBASE_EMAIL_LINK_REDIRECT_URL=http://localhost:3000/sign-in/finish

# Frontend API Mode:
# Set to "false" for live Firebase Auth, Firestore, and live email delivery.
# Set to "true" for local development preview with synthetic institutional data.
NEXT_PUBLIC_ENABLE_MOCK_API=false

# ==============================================================================
# Outbound Email Delivery Configuration
# Supported providers: "gmail" or "resend"
# ==============================================================================
EMAIL_PROVIDER=gmail

# --- Option A: Gmail SMTP Configuration (Recommended for direct institutional deployment) ---
# How to set up a Gmail App Password:
# 1. Enable 2-Step Verification on the Google Account:
#    Go to Google Account Settings -> Security -> 2-Step Verification.
# 2. Generate an App Password:
#    Go to Security -> 2-Step Verification -> App passwords (bottom of page).
#    Name it "IIITT Attendance Portal" and copy the 16-character password generated.
# 3. Quota & Deliverability Warnings:
#    - Free standard Gmail accounts are limited to ~500 emails per 24 hours (Google Workspace: ~2,000/day).
#    - Sending rapid automated bursts of sign-in links risks triggering Gmail anti-spam defenses
#      or temporary account sending suspensions.
#    - EMAIL_FROM must use the exact same address as GMAIL_USER (Gmail SMTP rejects address spoofing).
GMAIL_USER=admin-attendance@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="IIIT Trichy Attendance Portal <admin-attendance@gmail.com>"

# --- Option B: Resend Configuration (Alternative) ---
# If using Resend, set EMAIL_PROVIDER=resend and configure below:
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM="IIITT Portal <attendance@iiitt.ac.in>"

# ==============================================================================
# Firebase Client SDK Configuration (Public by design; access enforced via rules)
# Retrieve from Firebase Console: Project Settings -> General -> Your Apps -> Web App
# ==============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=iiitt-portal.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=iiitt-portal
NEXT_PUBLIC_FIREBASE_APP_ID=1:1234567890:web:xxxxxxxxxxxxxxx
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1234567890

# ==============================================================================
# Firebase Admin SDK Server-Only Configuration
# ==============================================================================
# Expected project identifier for privileged server-side access guard
FIREBASE_ADMIN_PROJECT_ID=iiitt-portal

# Complete service account JSON string exported from Firebase Console:
# Project Settings -> Service Accounts -> Generate New Private Key
# Escape newlines if needed, or pass as a single-line JSON string. NEVER commit this value.
FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"iiitt-portal","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"firebase-adminsdk-...@iiitt-portal.iam.gserviceaccount.com"}'

# Optional: Firebase Local Emulators (Leave unset for live cloud Firebase)
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
